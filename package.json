{
  "name": "@tessaridb/client",
  "version": "0.0.1-alpha",
  "description": "Client for TessariDB \u2014 the binary wire protocol for statements and change subscriptions, HTTP for objects, files, backup and operations",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tessaridb/tessaridb-sdk-js.git"
  },
  "homepage": "https://docs.tessaridb.com",
  "bugs": {
    "url": "https://github.com/tessaridb/tessaridb-sdk-js/issues"
  },
  "keywords": [
    "tessaridb",
    "database",
    "client",
    "driver",
    "multi-model"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 test/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run format:check && npm test",
    "prepublishOnly": "npm run check && npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  }
}
